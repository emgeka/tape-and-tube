<Window x:Class="Ntscrt.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tape &amp; Tube · Beta" Width="1400" Height="900" MinWidth="1040" MinHeight="680" Background="#10151C" Foreground="#E8EEF5" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <DockPanel Margin="24,20,24,16">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="38" Height="38" Background="#8CE3CF" CornerRadius="10" Margin="0,0,12,0"><Grid Margin="9"><Border BorderBrush="#183D35" BorderThickness="2" CornerRadius="5"/><Path Data="M 3 12 L 6 12 L 9 5 L 12 15 L 15 9 L 18 9" Stroke="#183D35" StrokeThickness="1.5" VerticalAlignment="Center"/></Grid></Border>
    <StackPanel><TextBlock Text="Tape &amp; Tube" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Ui001}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
    <Border x:Name="BuildChannelBadge" BorderBrush="#34404E" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="BETA" FontSize="10" Foreground="{StaticResource Muted}"/></Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{DynamicResource LanguageLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
    <ComboBox x:Name="LanguageChoice" Width="185" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource LanguageLabel}">
     <ComboBoxItem Tag="auto" Content="{DynamicResource SystemLanguage}"/>
    </ComboBox>
    <Button Content="{DynamicResource Ui002}" Click="ShowComponents" Margin="12,0,0,0" VerticalAlignment="Center" Background="Transparent"/>
    <Button x:Name="UpdatesButton" Content="Updates" Click="ShowUpdates" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent"/>
   </StackPanel>
  </Grid>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,18">
   <DockPanel x:Name="MediaActions" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
     <Button x:Name="ExportButton" Content="{DynamicResource Ui003}" IsEnabled="False" Click="ExportImage" ToolTip="{DynamicResource Ui004}"/>
     <Button x:Name="VideoExportButton" Content="{DynamicResource Ui005}" IsEnabled="False" Click="ExportVideo" Style="{StaticResource PrimaryButton}" Margin="0" ToolTip="{DynamicResource Ui006}"/>
    </StackPanel>
    <WrapPanel>
    <Button Content="{DynamicResource Ui007}" Click="OpenImage" Style="{StaticResource PrimaryButton}"/>
    <Button Content="{DynamicResource Ui008}" Click="OpenVideo"/>
    <Button Content="{DynamicResource Ui009}" Click="OpenDemo" Background="Transparent"/>
    <Border Width="1" Background="#34404E" Margin="8,4,16,4"/>
    <Button Content="{DynamicResource Ui010}" Click="LoadPreset" Background="Transparent"/>
    <Button Content="{DynamicResource Ui011}" Click="SavePreset" Background="Transparent"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="#29333F" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
   <DockPanel><Ellipse DockPanel.Dock="Left" Fill="{StaticResource Accent}" Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="{DynamicResource Ui012}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/></DockPanel>
  </Border>
  <Border x:Name="ExportPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,12,0,0">
   <DockPanel><Button x:Name="CancelExportButton" DockPanel.Dock="Right" Content="{DynamicResource Ui013}" Click="CancelExport" Margin="16,0,0,0"/><StackPanel><TextBlock x:Name="ExportProgressText" Text="{DynamicResource Ui014}" Margin="0,0,0,8"/><ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource Accent}" Background="#29333F" BorderThickness="0"/></StackPanel></DockPanel>
  </Border>
  <Grid x:Name="Editor">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="18"/><ColumnDefinition Width="370" MinWidth="330" MaxWidth="520"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <ToggleButton x:Name="SplitComparison" Content="{DynamicResource CompareLabel}" IsEnabled="False" Checked="SplitComparisonChanged" Unchecked="SplitComparisonChanged" ToolTip="{DynamicResource CompareHint}" Padding="10,5"/>
      <CheckBox x:Name="ShowOriginal" Content="{DynamicResource Ui015}" Checked="CompareChanged" Unchecked="CompareChanged" Margin="12,0,0,0"/>
     </StackPanel>
     <TextBlock Text="{DynamicResource Ui016}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#080B10" CornerRadius="10" BorderBrush="#29333F" BorderThickness="1" Padding="18">
     <Grid x:Name="PreviewHost" SizeChanged="PreviewSizeChanged" ClipToBounds="True">
      <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Canvas x:Name="OriginalLayer" Visibility="Collapsed" IsHitTestVisible="False">
       <Border x:Name="OriginalMatte" Background="Black"/>
       <Image x:Name="OriginalPreview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Canvas>
      <Canvas x:Name="DividerLayer" Visibility="Collapsed">
       <Thumb x:Name="CompareDivider" Width="32" Cursor="SizeWE" Focusable="False" DragDelta="CompareDividerDragged" ToolTip="{DynamicResource CompareHint}">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="2" Background="{StaticResource Accent}" HorizontalAlignment="Center"/><Border Width="32" Height="44" CornerRadius="10" Background="#142B28" BorderBrush="{StaticResource Accent}" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="↔" Foreground="{StaticResource Accent}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ControlTemplate></Thumb.Template>
       </Thumb>
      </Canvas>
      <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350">
       <Border Width="70" Height="54" BorderBrush="#3F5965" BorderThickness="2" CornerRadius="12" Margin="0,0,0,22"><Path Data="M 0 16 L 13 16 L 20 0 L 29 30 L 37 12 L 48 12" Stroke="#8CE3CF" StrokeThickness="2" Stretch="Uniform" Margin="10"/></Border>
       <TextBlock Text="{DynamicResource Ui017}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
       <TextBlock Text="{DynamicResource Ui018}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="14" LineHeight="23"/>
       <Button Content="{DynamicResource Ui019}" Click="OpenDemo" HorizontalAlignment="Center" Margin="0,24,0,0" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="ComparisonControls" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,6" Margin="0,10,0,0">
     <DockPanel><TextBlock DockPanel.Dock="Left" Text="{DynamicResource CompareOriginal}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><TextBlock DockPanel.Dock="Right" Text="{DynamicResource CompareOutput}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/><Slider x:Name="ComparePosition" Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" ValueChanged="SplitPositionChanged" AutomationProperties.Name="{DynamicResource ComparePositionLabel}"/></DockPanel>
    </Border>
    <Border x:Name="VideoTransport" Grid.Row="3" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
     <StackPanel>
      <Slider x:Name="FrameSlider" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="SeekVideo" AutomationProperties.Name="{DynamicResource Ui020}"/>
      <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviousFrameButton" Content="{DynamicResource Ui021}" Click="PreviousFrame"/><Button x:Name="PlayButton" Content="{DynamicResource Ui022}" Click="TogglePlayback" MinWidth="100" Style="{StaticResource PrimaryButton}"/><Button x:Name="NextFrameButton" Content="{DynamicResource Ui023}" Click="NextFrame"/><ToggleButton x:Name="LoopPlaybackButton" Content="{DynamicResource LoopLabel}" Margin="0,0,12,0" ToolTip="{DynamicResource Ui024}"/><TextBlock x:Name="VideoPosition" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></WrapPanel>
      <TextBlock Text="{DynamicResource Ui025}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="{DynamicResource Ui026}"/>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
    <TabControl>
     <TabItem Header="{DynamicResource Ui027}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,18,18,14">
       <StackPanel>
        <TextBlock Text="{DynamicResource Ui028}" Style="{StaticResource SectionLabel}"/>
        <Border BorderBrush="#34404E" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
         <StackPanel><TextBlock Text="{DynamicResource SignalStage}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/><CheckBox x:Name="NtscEnabled" Content="NTSC / VHS" FontSize="16" FontWeight="SemiBold" IsChecked="True" Checked="Changed" Unchecked="Changed"/><TextBlock Text="{DynamicResource Ui029}" Foreground="{StaticResource Muted}" FontSize="12" Margin="28,0,0,8"/><Expander Header="{DynamicResource Ui030}"><StackPanel x:Name="NtscControls"/></Expander></StackPanel>
        </Border>
        <StackPanel><TextBlock Text="{DynamicResource Ui031}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/><CheckBox x:Name="CrtEnabled" Content="CRT" FontSize="16" FontWeight="SemiBold" IsChecked="True" Checked="Changed" Unchecked="Changed"/><TextBlock Text="{DynamicResource Ui032}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,16"/>
         <TextBlock Text="Shader" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="ShaderChoice" SelectionChanged="ShaderChanged" Margin="0,0,0,14"/>
         <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Ui033}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="WidthChoice" SelectionChanged="Changed"><ComboBoxItem Content="256"/><ComboBoxItem Content="320" IsSelected="True"/><ComboBoxItem Content="640"/><ComboBoxItem Content="1280"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Ui034}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="ScaleChoice" SelectionChanged="Changed" ToolTip="{DynamicResource Ui035}"><ComboBoxItem Content="2"/><ComboBoxItem Content="3" IsSelected="True"/><ComboBoxItem Content="4"/></ComboBox></StackPanel></Grid>
         <Expander Header="{DynamicResource Ui036}" IsExpanded="True"><StackPanel x:Name="CrtControls"/></Expander>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="{DynamicResource Ui037}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
       <StackPanel>
        <StackPanel x:Name="OutputOptions">
         <TextBlock Text="{DynamicResource Ui038}" Style="{StaticResource SectionLabel}"/><TextBlock Text="{DynamicResource Ui039}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource Ui040}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22"/>
         <TextBlock Text="{DynamicResource Ui041}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="OutputChoice" SelectionChanged="OutputChoiceChanged" AutomationProperties.Name="{DynamicResource Ui042}" Margin="0,0,0,14"><ComboBoxItem Content="{DynamicResource Ui043}" IsSelected="True"/><ComboBoxItem Content="720p · 1280 × 720"/><ComboBoxItem Content="1080p · 1920 × 1080"/><ComboBoxItem Content="4K · 3840 × 2160"/><ComboBoxItem Content="{DynamicResource Ui044}"/></ComboBox>
         <StackPanel x:Name="CustomOutputFields" Visibility="Collapsed" Margin="0,0,0,14"><TextBlock Text="{DynamicResource Ui045}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="OutputWidth" Text="1920" TextChanged="CustomOutputChanged" AutomationProperties.Name="{DynamicResource Ui046}"/><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox Grid.Column="2" x:Name="OutputHeight" Text="1080" TextChanged="CustomOutputChanged" AutomationProperties.Name="{DynamicResource Ui047}"/></Grid></StackPanel>
         <TextBlock Text="{DynamicResource Ui048}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="OutputFitChoice" IsEnabled="False" SelectionChanged="OutputFitChanged" AutomationProperties.Name="{DynamicResource Ui049}" Margin="0,0,0,14"><ComboBoxItem Content="{DynamicResource Ui050}" IsSelected="True"/><ComboBoxItem Content="{DynamicResource Ui051}"/></ComboBox>
         <Border Background="#11171E" CornerRadius="6" Padding="12"><TextBlock x:Name="OutputSizeInfo" Text="{DynamicResource Ui052}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" LineHeight="20"/></Border>
        </StackPanel>
        <Border BorderBrush="#34404E" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="{DynamicResource Ui053}" Style="{StaticResource SectionLabel}"/><TextBlock Text="{DynamicResource Ui054}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" LineHeight="20" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource Ui055}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20"/></StackPanel></Border>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
 </DockPanel>
</Window>


